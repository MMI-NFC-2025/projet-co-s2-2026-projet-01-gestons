---
import home from "../assets/icon/home.svg";
import training from "../assets/icon/training.svg";
import mascotte from "../assets/icon/mascotte.svg";
import battle from "../assets/icon/battle.svg";
import settings from "../assets/icon/settings.svg";

const links = [
    { href: "/home", label: "Home", icon: home.src },
    { href: "/training", label: "Entrainement", icon: training.src },
    { href: "/perso", label: "Personnalisation", icon: mascotte.src },
    { href: "/battle", label: "Battle", icon: battle.src },
    { href: "/account", label: "Compte", icon: settings.src },
];
---

<nav
    id="bottom-nav"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2.5rem)] max-w-lg"
    aria-label="Navigation principale"
>
    <style>
        @keyframes nav-float {
            0%,
            100% {
                transform: translateY(0px) scale(1);
            }
            50% {
                transform: translateY(-14px) scale(1.03);
            }
        }
        #bottom-nav {
            animation: nav-float 2.8s ease-in-out infinite;
        }
        /* pause l'animation si l'utilisateur preferé moins de mouvement */
        @media (prefers-reduced-motion: reduce) {
            #bottom-nav {
                animation: none;
            }
        }
    </style>
    <ul
        class="bg-(--light-green) rounded-full px-4 py-3 flex items-center justify-around shadow-2xl shadow-black/70"
    >
        {
            links.map(({ href, label, icon }) => (
                <li>
                    <a
                        href={href}
                        class="flex flex-col items-center gap-1 hover:opacity-75 transition-opacity"
                        aria-label={label}
                    >
                        {href === "/perso" ? (
                            <span class="w-8 h-8 rounded-full overflow-hidden border-2 border-(--green) bg-white shrink-0 flex items-center justify-center">
                                <img
                                    id="nav-avatar-img"
                                    src={icon}
                                    alt=""
                                    aria-hidden="true"
                                    class="w-full h-full object-cover"
                                />
                            </span>
                        ) : (
                            <img
                                src={icon}
                                alt=""
                                aria-hidden="true"
                                class="w-8 h-8"
                            />
                        )}
                        <span class="font-lato text-[10px] font-bold text-(--green)">
                            {label}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<script>
    import PocketBase from "pocketbase";

    // Mettre à jour l'avatar dans la nav
    const navAvatarImg = document.getElementById(
        "nav-avatar-img",
    ) as HTMLImageElement | null;
    if (navAvatarImg) {
        try {
            const pb = new PocketBase("https://gestons.girardin-tarby.fr");
            if (pb.authStore.isValid && pb.authStore.model) {
                const userRecord = await pb
                    .collection("users")
                    .getOne(pb.authStore.model.id, { fields: "avatar" });
                const avatarId = userRecord["avatar"] as string | undefined;
                if (avatarId) {
                    const avatarRec = await pb
                        .collection("pdp")
                        .getOne(avatarId, {
                            fields: "id,pdp_img,collectionId",
                        });
                    navAvatarImg.src = `https://gestons.girardin-tarby.fr/api/files/${avatarRec.collectionId}/${avatarRec.id}/${avatarRec.pdp_img}`;
                }
            }
        } catch {}
    }

    const nav = document.getElementById("bottom-nav");
    const footer = document.querySelector("footer");
    if (nav && footer) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                nav.style.opacity = entry.isIntersecting ? "0" : "1";
                nav.style.pointerEvents = entry.isIntersecting
                    ? "none"
                    : "auto";
            },
            { threshold: 0.1 },
        );
        observer.observe(footer);
    }
</script>
