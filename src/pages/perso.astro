---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
---

<Layout title="Personnalisation — Gestons!">
    <section class="px-5 pt-6 pb-32 flex flex-col gap-8">
        <div>
            <h1
                class="font-gill font-black text-4xl sm:text-5xl text-(--green) uppercase leading-tight break-words"
            >
                Personnalisation
            </h1>
            <div class="flex justify-between items-start mt-4">
                <div
                    class="w-20 h-20 rounded-full border-4 border-(--light-green) overflow-hidden bg-gray-100 shrink-0"
                >
                    <img
                        id="avatar-preview"
                        src=""
                        alt="Aperçu de l'avatar"
                        class="w-full h-full object-cover"
                    />
                </div>
                <BackButton href="/account" label="<- Retour" />
            </div>
        </div>

        <div class="flex flex-col gap-3">
            <h2 class="font-gill font-black text-2xl text-(--green)">
                Choix de l'avatar
            </h2>
            <p class="font-lato text-xs text-gray-500">
                Certains avatars se débloquent en gagnant de l'XP. Joue pour les
                obtenir !
            </p>
            <div id="avatar-grid" class="grid grid-cols-4 gap-3">
                <!-- rempli dynamiquement par le script -->
            </div>
            <p
                id="avatar-saved-msg"
                class="hidden text-(--light-green) font-lato font-bold text-sm"
            >
                Avatar sauvegardé !
            </p>
        </div>
    </section>
</Layout>

<script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("https://gestons.girardin-tarby.fr");

    if (!pb.authStore.isValid) {
        location.href = "/connexion";
    }

    const user = pb.authStore.model;

    // Charger et afficher les avatars disponibles
    const grid = document.getElementById("avatar-grid") as HTMLElement;
    let currentAvatar = "";
    let userLevel = 0;

    let userXp = 0;

    if (user) {
        try {
            const userRecord = await pb.collection("users").getOne(user.id);
            currentAvatar = (userRecord["avatar"] as string) ?? "";
            userXp =
                typeof userRecord["xp_earned"] === "number"
                    ? userRecord["xp_earned"]
                    : 0;
            userLevel = Math.floor(userXp / 50);
        } catch {}
    }

    try {
        const pdpRecords = await pb
            .collection("pdp")
            .getFullList({ fields: "id,pdp_img,collectionId,xp_requis" });

        pdpRecords.sort((a, b) => {
            const xpA = typeof a["xp_requis"] === "number" ? a["xp_requis"] : 0;
            const xpB = typeof b["xp_requis"] === "number" ? b["xp_requis"] : 0;
            return xpA - xpB;
        });

        pdpRecords.forEach((r) => {
            const url = `https://gestons.girardin-tarby.fr/api/files/${r.collectionId}/${r.id}/${r.pdp_img}`;
            const isSelected = r.id === currentAvatar;

            // Utilise xp_requis du champ PocketBase (0 ou absent = libre)
            const requiredXp =
                typeof r["xp_requis"] === "number" ? r["xp_requis"] : 0;
            const requiredLevel = Math.floor(requiredXp / 50);
            const isLocked = userXp < requiredXp;

            const btn = document.createElement("button");
            btn.type = "button";
            btn.dataset.avatarId = r.id;
            btn.dataset.avatarUrl = url;

            if (isLocked) {
                btn.disabled = true;
                btn.ariaLabel = `Avatar verrouillé — niveau ${requiredLevel} requis (${requiredXp} XP)`;
                btn.className =
                    "avatar-btn w-full aspect-square rounded-2xl overflow-hidden border-4 border-transparent relative opacity-50 cursor-not-allowed";
                btn.innerHTML = `
                    <img src="${url}" alt="" aria-hidden="true" loading="lazy" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center gap-0.5">
                        <span class="text-2xl">🔒</span>
                        <span class="text-white font-gill font-black text-xs">Niv. ${requiredLevel}</span>
                    </div>`;
            } else {
                btn.className = `avatar-btn w-full aspect-square rounded-2xl overflow-hidden border-4 transition-all focus:outline-none ${
                    isSelected
                        ? "border-(--green)"
                        : "border-transparent hover:border-(--light-green)"
                }`;
                btn.ariaLabel = "Choisir cet avatar";
                btn.innerHTML = `<img src="${url}" alt="Avatar" loading="lazy" class="w-full h-full object-cover" />`;

                if (isSelected) {
                    const previewImg = document.getElementById(
                        "avatar-preview",
                    ) as HTMLImageElement | null;
                    if (previewImg) previewImg.src = url;
                }

                btn.addEventListener("click", async () => {
                    if (!user) return;
                    document
                        .querySelectorAll<HTMLButtonElement>(
                            ".avatar-btn:not(:disabled)",
                        )
                        .forEach((b) => {
                            b.className =
                                b.className
                                    .replace(
                                        "border-(--green)",
                                        "border-transparent",
                                    )
                                    .replace(
                                        "hover:border-(--light-green)",
                                        "",
                                    ) + " hover:border-(--light-green)";
                        });
                    btn.className = btn.className
                        .replace("border-transparent", "border-(--green)")
                        .replace("hover:border-(--light-green)", "");

                    const previewImg = document.getElementById(
                        "avatar-preview",
                    ) as HTMLImageElement | null;
                    if (previewImg) previewImg.src = url;

                    try {
                        await pb
                            .collection("users")
                            .update(user.id, { avatar: r.id });
                        const msg = document.getElementById("avatar-saved-msg");
                        if (msg) {
                            msg.classList.remove("hidden");
                            setTimeout(() => msg.classList.add("hidden"), 2000);
                        }
                    } catch (e) {
                        console.error("Erreur sauvegarde avatar :", e);
                    }
                });
            }

            grid.appendChild(btn);
        });
    } catch (e) {
        console.error("Erreur chargement avatars :", e);
    }
</script>
