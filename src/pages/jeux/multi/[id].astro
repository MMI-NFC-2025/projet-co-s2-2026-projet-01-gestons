---
import PocketBase from "pocketbase";
import Layout from "../../../layouts/Layout.astro";
import mascotteImg from "../../../assets/img/mascotte1.avif";
import checkIcon from "../../../assets/icon/check.svg";
import mascotteIcon from "../../../assets/icon/mascotte.svg";
import mascotteOnIcon from "../../../assets/icon/mascotte-on.svg";

const { id } = Astro.params;

const pb = new PocketBase("https://gestons.girardin-tarby.fr");
const records = await pb.collection("mot").getFullList();

const noms = records.map((r) => r.mot_associe as string);

const mots = records.map((record) => {
    const videoUrl = record.video_mot
        ? `https://gestons.girardin-tarby.fr/api/files/${record.collectionId}/${record.id}/${record.video_mot}`
        : null;
    const bonne = record.mot_associe as string;
    const autres = noms.filter((n) => n !== bonne);
    const mauvaises: string[] = [];
    const pool = [...autres].sort(() => Math.random() - 0.5);
    while (mauvaises.length < 3 && pool.length) mauvaises.push(pool.pop()!);
    const reponses = [bonne, ...mauvaises].sort(() => Math.random() - 0.5);
    return { id: record.id, videoUrl, reponses, bonne_reponse: bonne };
});

const participants = [
    { id: "p1", name: "Lucas07", avatar: null, score: 0, done: false },
    { id: "p2", name: "Chloé12", avatar: null, score: 0, done: false },
    { id: "p3", name: "Lola01", avatar: null, score: 0, done: false },
    { id: "p4", name: "Moi", avatar: null, score: 0, done: false },
];

const session = { id, duree: 120 };
const myId = "p4";
---

<Layout title="Battle — Gestons!">
    <section
        class="px-5 pt-6 pb-32 flex flex-col gap-6 select-none"
        id="battle-page"
    >
        <h1
            class="font-gill font-black text-5xl text-(--green) uppercase text-center"
        >
            BATTLE
        </h1>

        <div class="flex justify-center">
            <div
                id="timer-display"
                class="bg-(--light-green) text-white font-gill font-black text-5xl rounded-2xl px-10 py-4 tabular-nums tracking-wider"
            >
                2:00
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="flex items-center -space-x-2">
                {
                    participants.map((p) => (
                        <div
                            class="w-10 h-10 rounded-full border-2 border-white flex items-center justify-center shrink-0"
                            style={
                                p.done
                                    ? "background-color: var(--light-green)"
                                    : "background-color: var(--pink)"
                            }
                        >
                            {p.done ? (
                                <img
                                    src={checkIcon.src}
                                    alt=""
                                    class="w-5 h-5"
                                    aria-hidden="true"
                                />
                            ) : (
                                <img
                                    src={mascotteIcon.src}
                                    alt=""
                                    class="w-6 h-6"
                                    aria-hidden="true"
                                />
                            )}
                        </div>
                    ))
                }
            </div>
            <span
                class="font-gill font-black text-sm text-(--green) uppercase leading-tight"
            >
                Suivis des autres<br />participants
            </span>
        </div>

        <div
            id="card"
            class="w-full bg-(--light-green) rounded-3xl flex items-center justify-center overflow-hidden"
            style="min-height: 220px;"
        >
            <video
                id="card-video"
                class="w-full rounded-3xl hidden"
                playsinline
                muted></video>
            <p
                id="card-fallback"
                class="text-white font-gill font-black text-2xl hidden"
            >
                Pas de vidéo
            </p>
        </div>

        <div id="answers-grid" class="grid grid-cols-2 gap-3"></div>

        <div
            id="feedback"
            class="hidden text-center font-gill font-black text-2xl py-3 rounded-full"
        >
        </div>

        <div id="end-screen" class="hidden flex-col items-center gap-6 py-8">
            <p
                id="end-title"
                class="font-gill font-black text-4xl text-(--green) text-center"
            >
            </p>
            <p
                id="score-display"
                class="font-lato text-xl font-bold text-(--light-green)"
            >
            </p>
            <a
                href="/battle"
                class="bg-(--green) text-white font-sugo font-bold text-xl rounded-full px-8 py-3 hover:opacity-85 transition-all"
            >
                Retour au lobby
            </a>
            <a
                href="/classement"
                class="bg-(--light-green) text-white font-sugo font-bold text-xl rounded-full px-8 py-3 hover:opacity-85 transition-all shadow-[0_0_18px_4px_var(--light-green)]"
            >
                Voir le classement
            </a>
        </div>
    </section>
</Layout>

<script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("https://gestons.girardin-tarby.fr");

    if (!pb.authStore.isValid) {
        location.href = "/connexion";
    }

    interface Mot {
        id: string;
        videoUrl: string | null;
        reponses: string[];
        bonne_reponse: string;
    }

    let mots: Mot[] = [];
    let index = 0;
    let score = 0;
    let timeLeft = 120;
    let timerInterval: ReturnType<typeof setInterval> | null = null;
    let gameOver = false;

    const timerDisplay = document.getElementById(
        "timer-display",
    ) as HTMLElement;
    const cardVideo = document.getElementById("card-video") as HTMLVideoElement;
    const cardFallback = document.getElementById(
        "card-fallback",
    ) as HTMLElement;
    const answersGrid = document.getElementById("answers-grid") as HTMLElement;
    const feedback = document.getElementById("feedback") as HTMLElement;
    const endScreen = document.getElementById("end-screen") as HTMLElement;
    const endTitle = document.getElementById("end-title") as HTMLElement;
    const scoreDisplay = document.getElementById(
        "score-display",
    ) as HTMLElement;
    const card = document.getElementById("card") as HTMLElement;

    (async () => {
        const res = await fetch(
            "https://gestons.girardin-tarby.fr/api/collections/mot/records?perPage=200",
        );
        const data = await res.json();
        console.log("data:", data);
        const records: any[] = data.items ?? [];
        console.log("records:", records.length);
        console.log("premier record:", records[0]);
        const noms: string[] = records.map((r) => r.mot_associe);

        records.forEach((r) => {
            const videoFile = Array.isArray(r.video_mot)
                ? r.video_mot[0]
                : r.video_mot;
            const videoUrl = videoFile
                ? `https://gestons.girardin-tarby.fr/api/files/${r.collectionId}/${r.id}/${videoFile}`
                : null;
            const bonne: string = r.mot_associe;
            const autres = noms.filter((n: string) => n !== bonne);
            const pool = [...autres].sort(() => Math.random() - 0.5);
            const mauvaises = pool.slice(0, 3);
            const reponses = [bonne, ...mauvaises].sort(
                () => Math.random() - 0.5,
            );
            mots.push({ id: r.id, videoUrl, reponses, bonne_reponse: bonne });
        });

        mots.sort(() => Math.random() - 0.5);
        loadCard();
        startTimer();
    })();

    function formatTime(s: number): string {
        const m = Math.floor(s / 60);
        const sec = s % 60;
        return `${m}:${sec.toString().padStart(2, "0")}`;
    }

    function startTimer() {
        timerInterval = setInterval(() => {
            timeLeft--;
            timerDisplay.textContent = formatTime(timeLeft);
            if (timeLeft <= 10) {
                timerDisplay.style.backgroundColor = "var(--pink)";
                timerDisplay.style.color = "var(--green)";
            }
            if (timeLeft <= 0) {
                clearInterval(timerInterval!);
                showEnd(false);
            }
        }, 1000);
    }

    function loadCard() {
        if (!mots.length) return;
        const mot = mots[index % mots.length];
        if (mot.videoUrl) {
            cardVideo.src = mot.videoUrl;
            cardVideo.classList.remove("hidden");
            cardFallback.classList.add("hidden");
            cardVideo.play().catch(() => {});
        } else {
            cardVideo.classList.add("hidden");
            cardFallback.classList.remove("hidden");
        }
        card.classList.remove("scale-95");
        feedback.classList.add("hidden");
        feedback.textContent = "";
        answersGrid.innerHTML = "";
        const reponses = [...mot.reponses].sort(() => Math.random() - 0.5);
        reponses.forEach((rep) => {
            const btn = document.createElement("button");
            btn.textContent = rep;
            btn.className =
                "bg-(--pink) text-(--green) font-gill font-black text-2xl rounded-full py-4 px-4 hover:opacity-85 active:scale-95 transition-all focus:outline-none";
            btn.addEventListener("click", () => answer(rep, mot.bonne_reponse));
            answersGrid.appendChild(btn);
        });
    }

    function answer(choix: string, bonne: string) {
        if (gameOver) return;
        const correct = choix === bonne;
        feedback.classList.remove("hidden");
        if (correct) {
            feedback.textContent = "✓ Bonne réponse !";
            feedback.style.backgroundColor = "var(--light-green)";
            feedback.style.color = "white";
            score++;
        } else {
            feedback.textContent = `✗ C'était : ${bonne}`;
            feedback.style.backgroundColor = "var(--pink)";
            feedback.style.color = "var(--green)";
        }
        card.classList.add("scale-95");
        Array.from(answersGrid.children).forEach(
            (b) => ((b as HTMLButtonElement).disabled = true),
        );
        setTimeout(() => {
            if (!gameOver) {
                index++;
                loadCard();
            }
        }, 1000);
    }

    function showEnd(fini: boolean) {
        gameOver = true;
        if (timerInterval) clearInterval(timerInterval);
        answersGrid.innerHTML = "";
        feedback.classList.add("hidden");
        card.style.display = "none";
        answersGrid.style.display = "none";
        endTitle.textContent = fini ? "Bravo, terminé !" : "Temps écoulé !";
        scoreDisplay.textContent = `Score : ${score} / ${mots.length}`;
        endScreen.classList.remove("hidden");
        endScreen.classList.add("flex");
    }
</script>
