---
import PocketBase from "pocketbase";
import Layout from "../../../layouts/Layout.astro";
import mascotteImg from "../../../assets/img/mascotte1.avif";
import checkIcon from "../../../assets/icon/check.svg";
import mascotteIcon from "../../../assets/icon/mascotte.svg";
import mascotteOnIcon from "../../../assets/icon/mascotte-on.svg";

const { id } = Astro.params;

const pb = new PocketBase("https://gestons.girardin-tarby.fr");
const records = await pb.collection("mot").getFullList();

const noms = records.map((r) => r.mot_associe as string);

const mots = records.map((record) => {
    const videoUrl = record.video_mot
        ? `https://gestons.girardin-tarby.fr/api/files/${record.collectionId}/${record.id}/${record.video_mot}`
        : null;
    const bonne = record.mot_associe as string;
    const autres = noms.filter((n) => n !== bonne);
    const mauvaises: string[] = [];
    const pool = [...autres].sort(() => Math.random() - 0.5);
    while (mauvaises.length < 3 && pool.length) mauvaises.push(pool.pop()!);
    const reponses = [bonne, ...mauvaises].sort(() => Math.random() - 0.5);
    return { id: record.id, videoUrl, reponses, bonne_reponse: bonne };
});

const participants = [
    { id: "p1", name: "Lucas07", avatar: null, score: 0, done: false },
    { id: "p2", name: "Chloé12", avatar: null, score: 0, done: false },
    { id: "p3", name: "Lola01", avatar: null, score: 0, done: false },
    { id: "p4", name: "Moi", avatar: null, score: 0, done: false },
];

const session = { id, duree: 60 };
const myId = "p4";
---

<Layout title="Battle — Gestons!">
    <div
        id="battle-lightbox"
        class="fixed inset-0 z-50 bg-white flex flex-col overflow-hidden"
        aria-modal="true"
        role="dialog"
        aria-label="Jeu Battle"
    >
        <!-- Header -->
        <div class="flex items-center justify-between px-5 pt-5 pb-2 shrink-0">
            <h1 class="font-gill font-black text-3xl text-(--green) uppercase">
                BATTLE
            </h1>
            <div
                id="timer-display"
                class="bg-(--light-green) text-white font-gill font-black text-3xl rounded-2xl px-6 py-2 tabular-nums tracking-wider"
            >
                1:00
            </div>
        </div>

        <!-- Countdown overlay -->
        <div
            id="countdown-overlay"
            class="absolute inset-0 z-20 bg-white flex flex-col items-center justify-center gap-4"
        >
            <p
                class="font-gill font-black text-xl text-(--green) uppercase tracking-widest"
            >
                La bataille commence dans
            </p>
            <span
                id="countdown-number"
                class="font-gill font-black text-[9rem] text-(--light-green) leading-none transition-all duration-300"
                >3</span
            >
        </div>

        <!-- Waiting screen -->
        <div
            id="waiting-screen"
            class="absolute inset-0 z-20 bg-white hidden flex-col items-center justify-center gap-6"
        >
            <p
                class="font-gill font-black text-2xl text-(--green) text-center leading-snug"
            >
                En attente du score<br />de l'adversaire…
            </p>
            <div class="flex gap-2">
                <span
                    class="w-3 h-3 rounded-full bg-(--light-green) animate-bounce"
                    style="animation-delay:0ms"></span>
                <span
                    class="w-3 h-3 rounded-full bg-(--light-green) animate-bounce"
                    style="animation-delay:150ms"></span>
                <span
                    class="w-3 h-3 rounded-full bg-(--light-green) animate-bounce"
                    style="animation-delay:300ms"></span>
            </div>
        </div>

        <!-- Contenu scrollable -->
        <div
            class="flex flex-col gap-4 px-5 pb-6 overflow-y-auto flex-1 select-none"
        >
            <div
                id="card"
                class="mx-auto bg-(--light-green) rounded-3xl overflow-hidden leading-[0] max-w-md w-full"
            >
                <video
                    id="card-video"
                    class="w-full block rounded-3xl"
                    playsinline
                    muted></video>
                <p
                    id="card-fallback"
                    class="text-white font-gill font-black text-2xl hidden"
                >
                    Pas de vidéo
                </p>
            </div>

            <div id="answers-grid" class="grid grid-cols-2 gap-3"></div>

            <div
                id="feedback"
                class="hidden text-center font-gill font-black text-2xl py-3 rounded-full"
            >
            </div>
        </div>
    </div>
</Layout>

<script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("https://gestons.girardin-tarby.fr");

    if (!pb.authStore.isValid) {
        location.href = "/connexion";
    }

    // Bloquer le scroll et masquer la navbar
    document.body.style.overflow = "hidden";
    document.documentElement.style.overflow = "hidden";

    interface Mot {
        id: string;
        videoUrl: string | null;
        reponses: string[];
        bonne_reponse: string;
    }

    let mots: Mot[] = [];
    let index = 0;
    let score = 0;
    let attempted = 0;
    let timeLeft = 60;
    let timerInterval: ReturnType<typeof setInterval> | null = null;
    let gameOver = false;

    const timerDisplay = document.getElementById(
        "timer-display",
    ) as HTMLElement;
    const cardVideo = document.getElementById("card-video") as HTMLVideoElement;
    const cardFallback = document.getElementById(
        "card-fallback",
    ) as HTMLElement;
    const answersGrid = document.getElementById("answers-grid") as HTMLElement;
    const feedback = document.getElementById("feedback") as HTMLElement;
    const endScreen = document.getElementById("end-screen") as HTMLElement;
    const endTitle = document.getElementById("end-title") as HTMLElement;
    const scoreDisplay = document.getElementById(
        "score-display",
    ) as HTMLElement;
    const card = document.getElementById("card") as HTMLElement;

    (async () => {
        const res = await fetch(
            "https://gestons.girardin-tarby.fr/api/collections/mot/records?perPage=200",
        );
        const data = await res.json();
        console.log("data:", data);
        const records: any[] = data.items ?? [];
        console.log("records:", records.length);
        console.log("premier record:", records[0]);
        const noms: string[] = records.map((r) => r.mot_associe);

        records.forEach((r) => {
            const videoFile = Array.isArray(r.video_mot)
                ? r.video_mot[0]
                : r.video_mot;
            const videoUrl = videoFile
                ? `https://gestons.girardin-tarby.fr/api/files/${r.collectionId}/${r.id}/${videoFile}`
                : null;
            const bonne: string = r.mot_associe;
            const autres = noms.filter((n: string) => n !== bonne);
            const pool = [...autres].sort(() => Math.random() - 0.5);
            const mauvaises = pool.slice(0, 3);
            const reponses = [bonne, ...mauvaises].sort(
                () => Math.random() - 0.5,
            );
            mots.push({ id: r.id, videoUrl, reponses, bonne_reponse: bonne });
        });

        mots.sort(() => Math.random() - 0.5);

        // Countdown 3s
        const countdownOverlay = document.getElementById(
            "countdown-overlay",
        ) as HTMLElement;
        const countdownNumber = document.getElementById(
            "countdown-number",
        ) as HTMLElement;
        for (let i = 3; i >= 1; i--) {
            countdownNumber.textContent = String(i);
            countdownNumber.style.transform = "scale(1.2)";
            await new Promise<void>((r) => setTimeout(r, 100));
            countdownNumber.style.transform = "scale(1)";
            await new Promise<void>((r) => setTimeout(r, 900));
        }
        countdownOverlay.style.display = "none";

        loadCard();
        startTimer();
    })();

    function formatTime(s: number): string {
        const m = Math.floor(s / 60);
        const sec = s % 60;
        return `${m}:${sec.toString().padStart(2, "0")}`;
    }

    function startTimer() {
        const startTime = Date.now();
        timerInterval = setInterval(() => {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            timeLeft = Math.max(0, 60 - elapsed);
            timerDisplay.textContent = formatTime(timeLeft);
            if (timeLeft <= 10) {
                timerDisplay.style.backgroundColor = "var(--pink)";
                timerDisplay.style.color = "var(--green)";
            }
            if (timeLeft <= 0) {
                clearInterval(timerInterval!);
                showEnd(false);
            }
        }, 250);
    }

    function loadCard() {
        if (!mots.length) return;
        const mot = mots[index % mots.length];
        if (mot.videoUrl) {
            cardVideo.src = mot.videoUrl;
            cardVideo.classList.remove("hidden");
            cardFallback.classList.add("hidden");
            cardVideo.play().catch(() => {});
        } else {
            cardVideo.classList.add("hidden");
            cardFallback.classList.remove("hidden");
        }
        card.classList.remove("scale-95");
        feedback.classList.add("hidden");
        feedback.textContent = "";
        answersGrid.innerHTML = "";
        const reponses = [...mot.reponses].sort(() => Math.random() - 0.5);
        reponses.forEach((rep) => {
            const btn = document.createElement("button");
            btn.textContent = rep;
            btn.className =
                "bg-(--pink) text-(--green) font-gill font-black text-2xl rounded-full py-4 px-4 hover:opacity-85 active:scale-95 transition-all focus:outline-none";
            btn.addEventListener("click", () => answer(rep, mot.bonne_reponse));
            answersGrid.appendChild(btn);
        });
    }

    function answer(choix: string, bonne: string) {
        if (gameOver) return;
        attempted++;
        const correct = choix === bonne;
        feedback.classList.remove("hidden");
        if (correct) {
            feedback.textContent = "✓ Bonne réponse !";
            feedback.style.backgroundColor = "var(--light-green)";
            feedback.style.color = "white";
            score++;
        } else {
            feedback.textContent = `✗ C'était : ${bonne}`;
            feedback.style.backgroundColor = "var(--pink)";
            feedback.style.color = "var(--green)";
        }
        card.classList.add("scale-95");
        Array.from(answersGrid.children).forEach(
            (b) => ((b as HTMLButtonElement).disabled = true),
        );
        setTimeout(() => {
            if (!gameOver) {
                index++;
                loadCard();
            }
        }, 1000);
    }

    async function resetSalon(salonId: string) {
        try {
            await pb.collection("battle").update(salonId, {
                type_salon: "Disponible",
                user1: "",
                user2: "",
                score_user1: 999,
                score_user2: 999,
            });
        } catch (e) {
            console.error("Erreur reset salon :", e);
        }
    }

    async function showEnd(fini: boolean) {
        gameOver = true;
        if (timerInterval) clearInterval(timerInterval);

        const salonId = window.location.pathname.split("/").pop();
        if (!salonId) {
            window.location.href = `/classement?win=false&score=${score}&opponent=0&xp=0`;
            return;
        }

        try {
            const urlParams = new URLSearchParams(window.location.search);
            const mySlot = urlParams.get("slot") ?? "user1";
            const myScoreField =
                mySlot === "user1" ? "score_user1" : "score_user2";
            const opponentScoreField =
                mySlot === "user1" ? "score_user2" : "score_user1";
            const isUser1 = mySlot === "user1";

            // Sauvegarde mon score
            await pb.collection("battle").update(salonId, {
                [myScoreField]: score,
            });

            // Afficher le waiting screen
            const waitingScreen = document.getElementById(
                "waiting-screen",
            ) as HTMLElement;
            waitingScreen.classList.remove("hidden");
            waitingScreen.classList.add("flex");

            // Attend que l'adversaire ait soumis son score (poll toutes les 500ms, max 15s)
            let opponentScore = 0;
            let opponentSubmitted = false;
            for (let i = 0; i < 30; i++) {
                await new Promise<void>((r) => setTimeout(r, 500));
                const rec = await pb.collection("battle").getOne(salonId);
                const raw = rec[opponentScoreField];
                if (typeof raw === "number" && raw < 999) {
                    opponentScore = raw;
                    opponentSubmitted = true;
                    break;
                }
            }
            // Si l'adversaire n'a pas soumis après 15s → victoire par défaut
            const win = opponentSubmitted ? score > opponentScore : true;

            // Calcul et sauvegarde de l'XP
            const xpGained = score * 5 + (win ? 10 : 0);
            try {
                // Relire le record final pour avoir l'userId fiable
                const finalRec = await pb.collection("battle").getOne(salonId);
                const userId = finalRec[mySlot] as string;
                const user = await pb.collection("users").getOne(userId);
                const currentXp =
                    typeof user["xp_earned"] === "number"
                        ? user["xp_earned"]
                        : 0;
                const newXp = currentXp + xpGained;
                const newNiveau = Math.floor(newXp / 50);

                // Calcul streak
                const today = new Date().toISOString().slice(0, 10);
                const lastLogin: string =
                    typeof user["lastlogin"] === "string"
                        ? user["lastlogin"].slice(0, 10)
                        : "";
                const yesterday = new Date(Date.now() - 86400000)
                    .toISOString()
                    .slice(0, 10);
                const currentStreak: number =
                    typeof user["streak"] === "number" ? user["streak"] : 0;
                let newStreak: number;
                if (lastLogin === today) {
                    newStreak = currentStreak; // Déjà joué aujourd'hui
                } else if (lastLogin === yesterday) {
                    newStreak = currentStreak + 1; // Joué hier → on continue la streak
                } else {
                    newStreak = 1; // 2+ jours d'absence → reset
                }

                await pb.collection("users").update(userId, {
                    xp_earned: newXp,
                    level: newNiveau,
                    streak: newStreak,
                    lastlogin: new Date().toISOString(),
                });
            } catch (xpErr) {
                console.error("Erreur mise à jour XP :", xpErr);
            }

            // Seulement user1 remet le salon à disposition (évite double reset)
            if (isUser1) {
                await resetSalon(salonId);
            }

            window.location.href = `/classement?win=${win}&score=${score}&opponent=${opponentScore}&xp=${xpGained}`;
        } catch (e) {
            console.error("Erreur fin de partie :", e);
            window.location.href = `/classement?win=false&score=${score}&opponent=0&xp=0`;
        }
    }
</script>
