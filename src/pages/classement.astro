---
import Layout from "../layouts/Layout.astro";
import mascotte1 from "../assets/img/mascotte1.avif";
import mascotte2 from "../assets/img/mascotte2.avif";
---

<Layout title="Résultat — Gestons!">
    <section
        class="px-5 pt-12 pb-32 flex flex-col items-center gap-8 min-h-screen"
    >
        <!-- Victoire -->
        <div
            id="screen-victoire"
            class="hidden flex-col items-center gap-6 w-full text-center"
        >
            <h1
                class="font-gill font-black text-6xl text-(--green) leading-tight animate-bounce"
            >
                Victoire !
            </h1>
            <img
                src={mascotte1.src}
                alt="Mascotte victorieuse"
                loading="lazy"
                class="w-40 h-40 object-contain"
            />
            <img
                id="gif-victoire"
                src=""
                alt=""
                aria-hidden="true"
                class="hidden w-64 h-48 object-cover rounded-2xl"
            />
            <div
                class="bg-(--light-green) rounded-3xl px-10 py-6 flex flex-col gap-1 shadow-[0_0_24px_4px_var(--light-green)]"
            >
                <p
                    class="font-lato text-white text-sm uppercase tracking-widest"
                >
                    Ton score
                </p>
                <p
                    id="score-victoire"
                    class="font-gill font-black text-5xl text-white"
                >
                    — / —
                </p>
            </div>
            <p class="font-lato text-base text-(--green) font-bold">
                Bravo, tu as dominé la partie !
            </p>
            <div
                class="bg-(--green) rounded-2xl px-6 py-3 flex items-center gap-2"
            >
                <span class="font-gill font-black text-2xl text-(--pink)"
                    >+<span id="xp-victoire">0</span> XP</span
                >
            </div>
            <div class="flex flex-col gap-3 w-full items-center">
                <a
                    href="/battle"
                    class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-3 font-sugo font-bold text-xl transition-all bg-(--light-green) text-white border-2 border-white hover:opacity-85 shadow-[0_0_18px_4px_var(--light-green)]"
                >
                    Rejouer
                </a>
                <a
                    href="/home"
                    class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-3 font-sugo font-bold text-xl transition-all border-2 border-(--green) text-(--green) hover:bg-(--green) hover:text-white"
                >
                    Retour à l'accueil
                </a>
            </div>
        </div>

        <!-- Défaite -->
        <div
            id="screen-defaite"
            class="hidden flex-col items-center gap-6 w-full text-center"
        >
            <h1
                class="font-gill font-black text-6xl text-(--pink) leading-tight"
            >
                Défaite…
            </h1>
            <img
                src={mascotte2.src}
                alt="Mascotte déçue"
                loading="lazy"
                class="w-40 h-40 object-contain opacity-80"
            />
            <img
                id="gif-defaite"
                src=""
                alt=""
                aria-hidden="true"
                class="hidden w-64 h-48 object-cover rounded-2xl"
            />
            <div class="bg-(--pink) rounded-3xl px-10 py-6 flex flex-col gap-1">
                <p
                    class="font-lato text-(--green) text-sm uppercase tracking-widest"
                >
                    Ton score
                </p>
                <p
                    id="score-defaite"
                    class="font-gill font-black text-5xl text-(--green)"
                >
                    — / —
                </p>
            </div>
            <p class="font-lato text-base text-(--green) font-bold">
                Ne lâche rien, tu feras mieux la prochaine fois !
            </p>
            <div
                class="bg-(--green) rounded-2xl px-6 py-3 flex items-center gap-2"
            >
                <span class="font-gill font-black text-2xl text-(--pink)"
                    >+<span id="xp-defaite">0</span> XP</span
                >
            </div>
            <div class="flex flex-col gap-3 w-full items-center">
                <a
                    href="/battle"
                    class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-3 font-sugo font-bold text-xl transition-all bg-(--light-green) text-white border-2 border-white hover:opacity-85 shadow-[0_0_18px_4px_var(--light-green)]"
                >
                    Réessayer
                </a>
                <a
                    href="/training"
                    class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-3 font-sugo font-bold text-xl transition-all border-2 border-(--green) text-(--green) hover:bg-(--green) hover:text-white"
                >
                    S'entraîner en solo
                </a>
            </div>
        </div>
    </section>
</Layout>

<script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("https://gestons.girardin-tarby.fr");

    if (!pb.authStore.isValid) {
        location.href = "/connexion";
    }

    const params = new URLSearchParams(window.location.search);
    const score = parseInt(params.get("score") ?? "0");
    const opponent = parseInt(params.get("opponent") ?? "0");
    const xp = parseInt(params.get("xp") ?? "0");
    const victoire = params.get("win") === "true";

    const GIPHY_KEY = "0yXpwcIjmdRL1evrSRylqI0eerxkPuNL";

    async function fetchGif(
        query: string,
        attempt = 0,
    ): Promise<string | null> {
        try {
            const res = await fetch(
                `https://api.giphy.com/v1/gifs/search?api_key=${GIPHY_KEY}&q=${encodeURIComponent(query)}&limit=25&rating=g`,
            );
            if (res.status === 429 && attempt < 3) {
                await new Promise((r) => setTimeout(r, 500 + attempt * 500));
                return fetchGif(query, attempt + 1);
            }
            const data = await res.json();
            const gifs: any[] = data.data ?? [];
            if (!gifs.length) return null;
            const random = gifs[Math.floor(Math.random() * gifs.length)];
            return random.images.fixed_height.url as string;
        } catch {
            return null;
        }
    }

    if (victoire) {
        const screen = document.getElementById("screen-victoire")!;
        screen.classList.remove("hidden");
        screen.classList.add("flex");
        document.getElementById("score-victoire")!.textContent =
            `${score} pts vs ${opponent} pts`;
        document.getElementById("xp-victoire")!.textContent = String(xp);

        const gifUrl = await fetchGif("celebration");
        if (gifUrl) {
            const gifEl = document.getElementById(
                "gif-victoire",
            ) as HTMLImageElement;
            gifEl.src = gifUrl;
            gifEl.classList.remove("hidden");
        }
    } else {
        const screen = document.getElementById("screen-defaite")!;
        screen.classList.remove("hidden");
        screen.classList.add("flex");
        document.getElementById("score-defaite")!.textContent =
            `${score} pts vs ${opponent} pts`;
        document.getElementById("xp-defaite")!.textContent = String(xp);

        const gifUrl = await fetchGif("sad");
        if (gifUrl) {
            const gifEl = document.getElementById(
                "gif-defaite",
            ) as HTMLImageElement;
            gifEl.src = gifUrl;
            gifEl.classList.remove("hidden");
        }
    }
</script>
