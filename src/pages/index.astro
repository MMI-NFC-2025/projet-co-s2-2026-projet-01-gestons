---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CTAButton from "../components/CTAButton.astro";
import fusee from "../assets/icon/fusee.svg";
import logo from "../assets/icon/logo_dark-green.svg";
import breakpage from "../assets/icon/breakpage.svg";
import star from "../assets/icon/star.svg";
import rectangle from "../assets/icon/rectangle.svg";
import modeIcon from "../assets/icon/mode-icon.svg";
import magicwand from "../assets/icon/magicwand.svg";
import battle1 from "../assets/icon/battle1.svg";
import loupe from "../assets/icon/loupe.svg";
import training1 from "../assets/icon/training1.svg";
import mascotte1 from "../assets/img/mascotte1.avif";
import mascotte2 from "../assets/img/mascotte2.avif";
import multiplayer from "../assets/icon/multiplayer.svg";
import phoneHome from "../assets/img/mobilemockup1.avif";
import phoneGame from "../assets/img/mobilemockup2.avif";
---

<Layout title="Gestons! - Apprenez la langue des signes" landing={true}>
    <!-- Navigation desktop uniquement -->
    <nav
        class="hidden lg:flex items-center justify-between px-16 py-5 bg-(--light-green) shadow-sm"
    >
        <a href="/home" aria-label="Accueil Gestons!">
            <Image src={logo} alt="Gestons!" width={180} height={37} class="h-9 w-auto" />
        </a>
        <div class="flex items-center gap-6">
            <a
                href="/contact"
                class="font-lato text-base text-(--green) hover:opacity-70 transition-opacity"
                >Contact</a
            >
            <a
                href="/connexion"
                class="inline-flex items-center justify-center rounded-full px-7 py-2.5 font-sugo font-bold text-lg bg-(--pink) text-(--green) hover:opacity-85 transition-opacity"
                >Connexion</a
            >
            <a
                href="/inscription"
                class="inline-flex items-center justify-center gap-2 rounded-full px-7 py-2.5 font-sugo font-bold text-lg bg-(--green) text-white hover:opacity-85 transition-opacity"
            >
                <Image src={fusee} alt="" aria-hidden="true" width={20} height={20} class="w-5 h-5" />
                Inscription
            </a>
        </div>
    </nav>

    <section
        class="bg-(--light-green) px-5 pt-8 pb-0 relative overflow-visible lg:px-16 lg:pt-14"
    >
        <div
            class="max-w-lg mx-auto flex flex-col items-center gap-5 lg:max-w-7xl lg:flex-row lg:items-start lg:gap-16"
        >
            <!-- Colonne gauche : logo + texte + boutons -->
            <div
                class="relative z-30 flex flex-col items-center gap-5 lg:items-start lg:flex-1 lg:pb-16"
            >
                <a href="/home" aria-label="Accueil Gestons!" class="lg:hidden">
                    <Image
                        src={logo}
                        alt="Gestons!"
                        width={200}
                        height={41}
                        class="h-10 w-auto mb-8"
                    />
                </a>

                <h1
                    class="text-center lg:text-left text-6xl md:text-5xl lg:text-7xl font-gill font-black text-(--green) leading-tight mb-6"
                >
                    Apprenez la langue des signes
                </h1>

                <p
                    class="text-center lg:text-left font-lato text-base lg:text-lg text-(--green) max-w-sm lg:max-w-md"
                >
                    Tout en vous amusant venez découvrir et apprendre une langue
                    encore trop oubliée... la langue des signes française.
                </p>

                <div
                    class="flex items-center gap-4 flex-wrap justify-center lg:justify-start"
                >
                    <CTAButton
                        href="/inscription"
                        label="Inscription"
                        variant="primary"
                        icon={fusee}
                    />
                    <CTAButton
                        href="/connexion"
                        label="Connexion"
                        variant="secondary"
                    />
                </div>
            </div>

            <!-- Colonne droite : mockup téléphone -->
            <div
                class="relative w-full max-w-xs mx-auto mt-4 lg:mt-0 lg:max-w-sm lg:shrink-0"
            >
                <Image src={star} alt="" aria-hidden="true" width={36} height={36} class="absolute top-10 -left-4 w-9 h-auto z-20" />
                <Image src={star} alt="" aria-hidden="true" width={20} height={20} class="absolute top-2 right-0 w-5 h-auto z-20" />
                <Image src={star} alt="" aria-hidden="true" width={28} height={28} class="absolute bottom-24 -right-4 w-7 h-auto z-20" />
                <Image src={star} alt="" aria-hidden="true" width={16} height={16} class="absolute bottom-16 left-2 w-4 h-auto z-20" />
                <Image
                    src={phoneHome}
                    alt="Aperçu de l'application Gestons!"
                    class="relative z-10 block w-full drop-shadow-2xl ml-3"
                    widths={[320, 640]}
                    sizes="(max-width: 640px) 320px, 640px"
                />
                <Image src={rectangle} alt="" aria-hidden="true" width={400} height={80} class="absolute -bottom-4 left-0 right-0 w-full z-0" />
            </div>
        </div>
        <Image
            src={breakpage}
            alt=""
            aria-hidden="true"
            width={800}
            height={40}
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-screen h-10 object-fill z-20 translate-y-1/2"
        />
    </section>

    <!-- Notre objectif + cercle : côte à côte sur desktop -->
    <div
        class="lg:flex lg:items-center lg:gap-16 lg:max-w-7xl lg:mx-auto lg:px-16 lg:py-12"
    >
        <!-- Notre objectif (droite sur desktop) -->
        <section class="px-5 py-18 lg:px-0 lg:py-0 lg:flex-1 lg:order-2">
            <div class="max-w-lg mx-auto flex flex-col gap-6 lg:max-w-none">
                <h2
                    class="font-gill font-black text-3xl lg:text-4xl text-(--green)"
                >
                    Notre objectif...
                </h2>

                <p class="font-lato text-base text-gray-800 lg:text-lg">
                    ... vous faire apprendre la langue des signes française de
                    manière ludique&nbsp;!
                </p>

                <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
                    <div
                        class="flex items-center gap-3 rounded-2xl border border-gray-200 px-4 py-3 shadow-sm"
                    >
                        <Image src={modeIcon} alt="" aria-hidden="true" width={32} height={32} class="w-8 h-8 shrink-0" />
                        <span class="font-lato text-sm text-gray-800"
                            >Plusieurs modes</span
                        >
                    </div>

                    <div
                        class="flex items-center gap-3 rounded-2xl border border-gray-200 px-4 py-3 shadow-sm"
                    >
                        <Image src={magicwand} alt="" aria-hidden="true" width={32} height={32} class="w-8 h-8 shrink-0" />
                        <span class="font-lato text-sm text-gray-800"
                            >Facile à comprendre</span
                        >
                    </div>

                    <div
                        class="col-span-2 lg:col-span-1 flex items-center gap-3 rounded-2xl border border-gray-200 px-4 py-3 shadow-sm w-1/2 lg:w-full mx-auto lg:mx-0"
                    >
                        <Image src={multiplayer} alt="" aria-hidden="true" width={32} height={32} class="w-8 h-8 shrink-0" />
                        <span class="font-lato text-sm text-gray-800"
                            >Multijoueurs</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Cercle vert (gauche sur desktop) -->
        <section
            class="bg-(--green) px-1 relative mb-16 w-[379px] h-[379px] rounded-full mx-auto lg:mb-0 lg:mx-0 lg:order-1 lg:shrink-0"
        >
            <span
                class="absolute top-18 right-4 text-6xl text-(--pink) select-none"
                aria-hidden="true">✦</span
            >
            <span
                class="absolute bottom-35 left-6 text-6xl text-(--pink) select-none"
                aria-hidden="true">✦</span
            >
            <div
                class="max-w-lg mx-auto flex flex-col items-center gap-6 relative z-10"
            >
                <div class="w-full max-w-xs ml-20">
                    <Image
                        src={phoneGame}
                        alt="Aperçu du jeu VRAI / FAUX"
                        class="w-65 h-auto drop-shadow-2xl rounded-3xl"
                        widths={[214, 411]}
                        sizes="(max-width: 640px) 214px, 411px"
                    />
                </div>
            </div>
        </section>
    </div>

    <section class="px-5 py-10 lg:px-16 lg:py-20">
        <div class="max-w-lg mx-auto flex flex-col gap-8 lg:max-w-7xl">
            <h2
                class="font-sugo font-black text-4xl lg:text-5xl text-(--green)"
            >
                Nos Fonctionnalités
            </h2>

            <div
                class="flex flex-col gap-8 lg:grid lg:grid-cols-3 lg:gap-12 lg:items-start"
            >
                <div
                    class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5"
                >
                    <Image
                        src={loupe}
                        alt=""
                        aria-hidden="true"
                        width={48}
                        height={48}
                        class="w-12 h-12 shrink-0 mt-1 lg:w-14 lg:h-14 lg:mt-0"
                    />
                    <p class="font-lato text-sm text-gray-800 leading-relaxed">
                        <span class="font-bold">Notre moteur de recherche</span> conçu
                        pour traduire les expressions du français parlé vers le français
                        signé vous permettra de trouver instantanément la bonne expression
                        en LSF&nbsp;!
                    </p>
                </div>

                <Image
                    src={mascotte1}
                    alt=""
                    aria-hidden="true"
                    width={248}
                    height={248}
                    class="w-62 h-auto mx-auto lg:hidden"
                />

                <div
                    class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5"
                >
                    <p
                        class="font-lato text-sm text-gray-800 leading-relaxed lg:order-2"
                    >
                        Apprends la LSF autrement grâce à des <strong
                            >mini-jeux courts, intuitifs et motivants</strong
                        >. Mémorisation, reconnaissance visuelle, compréhension
                        des expressions&nbsp;: chaque jeu renforce tes réflexes
                        en français signé tout en rendant l'apprentissage
                        agréable et progressif.
                    </p>
                    <Image
                        src={training1}
                        alt=""
                        aria-hidden="true"
                        width={48}
                        height={48}
                        class="w-12 h-auto shrink-0 lg:order-1 lg:w-14"
                    />
                </div>

                <Image
                    src={mascotte2}
                    alt=""
                    aria-hidden="true"
                    width={248}
                    height={248}
                    class="w-62 h-auto mx-auto lg:hidden"
                />

                <div
                    class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5"
                >
                    <Image
                        src={battle1}
                        alt=""
                        aria-hidden="true"
                        width={48}
                        height={48}
                        class="w-12 h-12 shrink-0 mt-1 lg:w-14 lg:h-14 lg:mt-0"
                    />
                    <p class="font-lato text-sm text-gray-800 leading-relaxed">
                        <strong
                            >Affronte tes amis dans des mini-jeux rapides et fun</strong
                        > autour du français signé. Qui reconnaît le plus vite une
                        expression en LSF&nbsp;? Qui mémorise le mieux&nbsp;? Qui
                        ira le plus loin dans la série parfaite&nbsp;? Un mode compétitif
                        pensé pour apprendre en s'amusant et pour transformer chaque
                        partie en défi.
                    </p>
                </div>
            </div>

            <!-- Mascottes déco visibles uniquement sur desktop -->
            <div class="hidden lg:flex justify-around items-end mt-4">
                <Image src={mascotte1} alt="" aria-hidden="true" width={176} height={176} class="w-44 h-auto" />
                <Image src={mascotte2} alt="" aria-hidden="true" width={176} height={176} class="w-44 h-auto" />
            </div>
        </div>
    </section>
</Layout>
